{
  "id": "piz",
  "identity": {
    "binary": "piz",
    "versionCommand": [
      "piz",
      "--version"
    ],
    "versionRegex": "\\d+\\.\\d+\\.\\d+"
  },
  "versions": [
    {
      "range": "0.17.0 - *",
      "status": "provisional",
      "verifiedThrough": null,
      "verifiedOn": null
    }
  ],
  "idle": {
    "frame": {
      "walk": "interior",
      "top": {
        "pattern": "^─+(?:\\s+(?<label>.*[^\\s─-╿▁-▔‒-―].*?)\\s+─+)?$",
        "minCells": 8,
        "column": 0
      },
      "prompt": {
        "pattern": "^ {0,2}(?<draft>(?:(?!\\s{8,}\\S).)*)(?:\\s{8,}\\S.*)?$",
        "column": 0,
        "maxColumn": 2
      },
      "bottom": {
        "pattern": "^─+$",
        "minCells": 8,
        "column": 0
      },
      "continuationIndent": 0,
      "maxDraftRows": 30,
      "maxTailRows": 60,
      "under": "^(?: {1,4}\\S|~|/|[⠀-⣿]|[A-Za-z]:\\\\)",
      "underPainted": true
    },
    "placeholders": {
      "texts": [],
      "sgr": 2
    },
    "volatile": {
      "above": {
        "maxRows": 6,
        "losesText": true
      },
      "below": {
        "maxRows": 8,
        "footerMaxRows": 6,
        "commandList": {
          "lead": "/",
          "sides": [
            "under"
          ],
          "pointer": "^ {0,3}→ (?<command>[^\\s(]\\S*)(?: {2,}\\S.*)?$",
          "entry": "^ {2,5}(?<command>[^\\s(→]\\S*)(?: {2,}\\S.*)?$",
          "wrapped": "^ {2,5}\\(\\d+/\\d+\\)$",
          "footer": {
            "pattern": "^(?:\\S| ↳ \\S)",
            "maxRows": 6
          }
        }
      }
    },
    "runningRows": [
      "^[⠀-⣿] ",
      "\\besc to interrupt\\b"
    ]
  },
  "keys": {
    "submit": [
      "Enter"
    ],
    "commandSubmit": [
      "Enter"
    ],
    "newline": [
      "ctrl+j"
    ],
    "interrupt": [
      "Escape",
      "Escape"
    ],
    "clear": {
      "key": "Backspace",
      "slack": 16
    },
    "navigation": {
      "up": "Up",
      "down": "Down",
      "confirm": "Enter",
      "cancel": "Escape"
    },
    "enterWhileRunning": "steers",
    "queueKey": "ctrl+q",
    "queuedRow": {
      "pattern": "^\\s*⧉ (?:Follow-up|Steering): (?<text>\\S.*?)\\s*$",
      "hint": "^\\s*↳ Alt\\+Up restores queued inputs to the editor\\s*$",
      "hintGap": 0
    },
    "steer": [
      "Enter"
    ],
    "steerWitness": [
      {
        "pattern": "^\\s*⧉ Steering: (?<text>\\S.*?)",
        "hint": "^\\s*↳ Alt\\+Up restores queued inputs to the editor\\s*$",
        "hintGap": 0,
        "between": "^ {2}⧉ Follow-up: "
      }
    ]
  },
  "collapse": {
    "pattern": "\\[paste #\\d+ (?:\\+(?<lines>\\d+) lines|(?<chars>\\d+) chars)\\]"
  },
  "reservedLeads": [
    "/",
    "!"
  ],
  "probe": {
    "char": "⌁",
    "status": "provisional",
    "note": "piz 0.17.0 (bermudi's ZCode fork): frame and keymap pinned against a live pane capture plus tui-pi source on 2026-10-27 — footer.ts (Ready./cwd/stats rows under the box), chords.ts (Ctrl+Q queues, Alt+Up dequeues, double-Escape aborts), panels.ts (⧉ Follow-up/Steering rows), pi-tui Editor (─ box, blank interior, [paste #N] collapse markers, bracketed paste rewrap). No send lab yet — provisional."
  },
  "paste": {
    "bracketed": true,
    "block": true
  },
  "hooks": {}
}
