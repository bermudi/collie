{
  "id": "devin",
  "identity": {
    "binary": "devin",
    "versionCommand": [
      "devin",
      "version"
    ],
    "versionRegex": "\\d+\\.\\d+\\.\\d+"
  },
  "versions": [
    {
      "range": "3000.11.0 - *",
      "status": "provisional",
      "verifiedThrough": null,
      "verifiedOn": null
    }
  ],
  "idle": {
    "frame": {
      "walk": "edges",
      "top": {
        "pattern": "^─+(?:\\s+(?<label>.*[^\\s─-╿▁-▔‒-―].*?)\\s+─+)?$",
        "minCells": 8,
        "column": 0
      },
      "prompt": {
        "pattern": "^❭ ?(?<draft>.*)$",
        "column": 0
      },
      "bottom": {
        "pattern": "^─+$",
        "minCells": 8,
        "column": 0
      },
      "continuationIndent": 2,
      "maxDraftRows": 10,
      "maxTailRows": 10
    },
    "placeholders": {
      "texts": [
        "Ask Devin to build features, fix bugs, or work on your code",
        "Guide Devin while it works"
      ],
      "prefixes": [
        "Ask Devin",
        "Guide Devin"
      ],
      "sgr": 2
    },
    "volatile": {
      "above": {
        "maxRows": 4
      },
      "below": {
        "maxRows": 4,
        "footerMaxRows": 2
      }
    },
    "runningRows": [
      "^\\s*[⠀-⣿]+ ",
      "\\besc twice to interrupt\\)"
    ],
    "frameAlternates": [
      {
        "walk": "edges",
        "top": {
          "pattern": "^─+(?:\\s+(?<label>.*[^\\s─-╿▁-▔‒-―].*?)\\s+─+)?$",
          "minCells": 8,
          "column": 0
        },
        "prompt": {
          "pattern": "^(?<draft>!.*)$",
          "column": 0
        },
        "bottom": {
          "pattern": "^─+$",
          "minCells": 8,
          "column": 0
        },
        "continuationIndent": 2,
        "maxDraftRows": 10,
        "maxTailRows": 10
      }
    ]
  },
  "keys": {
    "submit": [
      "Enter"
    ],
    "newline": [
      "ctrl+j"
    ],
    "interrupt": [
      "Escape",
      "Escape"
    ],
    "clear": {
      "key": "Backspace",
      "slack": 16
    },
    "navigation": {
      "up": "Up",
      "down": "Down",
      "confirm": "Enter",
      "cancel": "Escape"
    },
    "enterWhileRunning": "steers",
    "queueKey": "Enter"
  },
  "collapse": {
    "pattern": "\\[Pasted text #\\d+ (?:\\+(?<lines>\\d+) lines|\\((?<chars>\\d+) chars\\))\\]"
  },
  "reservedLeads": [
    "/",
    "!"
  ],
  "probe": {
    "char": "⌁",
    "status": "provisional",
    "note": "Anchors and keys taken from live devin 3000.11.92 screens on Herdr and the shipped keymap docs (2026-10-17), not a lab run: provisional. Live-verified on 3000.11.92: Enter with a draft during a turn steers — the text echoes above the box and reaches the agent mid-turn (placeholder 'Guide Devin while it works'). Enter IS the commit, so the queue key is Enter itself. Devin's own queue ('── N queued ── ↑ edit · ↵ send now' over '○' rows) is for prompts it cannot take mid-turn (e.g. compaction); its hint banner sits ABOVE the queued rows, which keys.queuedRow's shape cannot express."
  },
  "hooks": {}
}
