{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    // The playground imports display names for the app's supported multiplexers from a JSON file
    // OUTSIDE `src/` (web/playground-fixtures/), because the repo guard (scripts/check-mux-names.sh)
    // forbids those words as string literals anywhere under `src/` — see row-second-line.tsx.
    "resolveJsonModule": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "paths": { "@/*": ["./src/*"] }
  },
  // src/sw.ts runs in a service-worker (not DOM) context, and src/stt/worker.ts in a dedicated
  // worker — both type-checked separately via tsconfig.worker.json (both run under `bun run typecheck`).
  "include": ["src", "vite.config.ts", "playground-fixtures"],
  "exclude": ["src/sw.ts", "src/stt/worker.ts"]
}
