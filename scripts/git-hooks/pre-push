#!/usr/bin/env bash
# Pre-push guard: the release-tag warning, and nothing else. Install with: scripts/install-hooks.sh
# (sets core.hooksPath to scripts/git-hooks, so this file runs straight from the checkout and edits
# are live at once).
#
# The batteries used to run here — typecheck both sides, the bridge suite, the ctl suite and the web
# suite: about five minutes on every push, and the web lane flaked under a loaded machine (three
# times on 2026-10-15 alone, on code that was green). The identical battery runs in ci.yml's `check`
# job on a clean runner, which now triggers on every branch push. That is the gate. Nothing local
# stands between a push and the remote any more.
# Override once: SKIP_TAG_CHECK=1 git push (skip the release-tag warning).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# git feeds a pre-push hook the refs being pushed on stdin, one `<local ref> <local sha> <remote ref>
# <remote sha>` line per ref. Read it NOW: check-tag.sh shells out to git, and git commands that read
# stdin would eat the ranges this loop works from.
pushed_refs="$(cat)"

# git has exported GIT_DIR (and, depending on the hook, GIT_INDEX_FILE and friends) into this process.
# Those override repository discovery for every git command a suite runs — `-C` included — which is
# how the ctl suite once re-initialised the developer's own checkout instead of its sandbox. check-tag.sh
# shells out to git too, so the variables are dropped once here, before anything inherits them.
unset "${!GIT_@}" 2>/dev/null || true

# ── Foreign-line tags (BLOCKS) ─────────────────────────────────────────────
# 2026-10-16: a `git push --follow-tags` after an upstream merge flushed 130 of upstream's v1.*
# tags into bermudi/collie. The update banner then announced upstream's 1.21.2 as "a new major",
# and `collie update --major` would have detached onto upstream's own commit. Pup's own line is
# 0.x, so any other tag pushed here is upstream's and arrived only by accident.
# Override once: PUSH_FOREIGN_TAGS=1 git push (e.g. the day Pup's own line leaves 0.x).
foreign=""
while read -r local_ref _rest; do
  case "$local_ref" in
    refs/tags/v0.*) ;;
    refs/tags/*) foreign="$foreign ${local_ref#refs/tags/}" ;;
  esac
done <<<"$pushed_refs"
if [ -n "$foreign" ] && [ "${PUSH_FOREIGN_TAGS:-}" != "1" ]; then
  {
    echo
    echo "✗ pre-push: refusing — this push carries tag(s) outside Pup's 0.x line:$foreign"
    echo "  upstream's tags belong to upstream; a merge makes them reachable, and --follow-tags"
    echo "  flushes them all. Push the branch by name; push a release tag explicitly:"
    echo "      git push origin vX.Y.Z"
    echo "  (Override once: PUSH_FOREIGN_TAGS=1 git push.)"
    echo
  } >&2
  exit 1
fi

# ── Release tag (WARNS, never blocks) ───────────────────────────────────────
# Betas 33 to 41 were cut in the version files and the CHANGELOG and never tagged, so nine releases
# existed that nobody could install. The release workflow was fine; the `git tag` in front of it was
# the step that kept getting skipped, and nothing ever said so. This says so.
#
# It WARNS rather than aborting on purpose: the tag may legitimately be cut after CI has had a look
# at the release commit, and a guard that blocks a push you meant to make gets disarmed for good
# rather than once. It runs LAST so its message is the final thing on the screen — the same reason
# the update notice moved to the end of the transcript.
if [ "${SKIP_TAG_CHECK:-}" = "1" ]; then
  echo "pre-push: SKIP_TAG_CHECK=1 — skipping the release-tag check" >&2
else
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    # A deleted ref pushes the all-zero sha and carries no commits.
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac
    # A brand-new remote branch has no remote sha to subtract; ask for what no remote holds yet.
    case "$remote_sha" in
      *[!0]*) selector=("${remote_sha}..${local_sha}") ;;
      *) selector=("$local_sha" --not --remotes) ;;
    esac
    if ! out="$(cd "$ROOT" && bash scripts/check-tag.sh "${selector[@]}" 2>&1)"; then
      {
        echo
        echo "⚠ pre-push: this push carries a release with no tag — nothing will publish it."
        echo
        echo "$out" | sed 's/^✗ /  /'
        echo "  (Push anyway; tag it before or right after. Silence this once: SKIP_TAG_CHECK=1 git push.)"
        echo
      } >&2
    fi
  done <<<"$pushed_refs"
fi

exit 0
